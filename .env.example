# sluicery 環境設定
# このファイルをコピーして .env を作成し、値を設定すること。
#   cp .env.example .env
#
# .env 自体はコミットしないこと（.gitignore で除外済み）。

# 必須。Fernet 暗号化鍵の元になる。未設定の場合は起動を拒否する。
# 生成例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 初回起動時のみ使用する管理者アカウント。
ADMIN_USERNAME=admin
# 空の場合はランダム生成し、起動ログに1回だけ出力する。
ADMIN_PASSWORD=

# タイムゾーン。cron 式はこの TZ で解釈する。
TZ=Asia/Tokyo

# 生成ファイルの所有者・権限。
PUID=1000
PGID=1000
UMASK=022

# Web UI の待受ポート。
HTTP_PORT=8080

# DB・yt-dlp venv・ログを置く永続ディレクトリ（コンテナ内パス）。
DATA_DIR=/data
# ダウンロードと後処理の一時領域（コンテナ内パス、常にローカル）。
STAGING_DIR=/data/staging

# local Storage 用の bind mount 先（ホスト側パス）。
MEDIA_ROOT=/mnt/media

# Staging 容量監視のしきい値（使用率 %）。
STAGING_WARN_PCT=80
STAGING_STOP_PCT=90

# ログ保持日数。
LOG_RETENTION_DAYS=30

# --exec / --exec-before-download の許可。Profile 側の allow_exec との両方が
# 有効な場合のみ許可される（要件定義 §9.3）。
ALLOW_EXEC=false

# yt-dlp 自動更新のスケジュール（cron 式、TZ 上で解釈）。
YTDLP_UPDATE_CRON=0 4 * * 0

# yt-dlp 更新後のスモークテストに使う既知の公開URL（Creative Commons 等）。
YTDLP_SMOKETEST_URL=
