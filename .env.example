# sluicery 環境設定
# このファイルをコピーして .env を作成し、値を設定すること。
#   cp .env.example .env
#
# .env 自体はコミットしないこと（.gitignore で除外済み）。

# 必須。Fernet 暗号化鍵そのもの。未設定の場合は起動を拒否する。
# 生成例: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# この鍵を紛失すると、保存済みの認証情報を復号できなくなる（ローテーション非対応）。
SECRET_KEY=

# 初回起動時のみ使用する管理者アカウント。
ADMIN_USERNAME=admin
# 空の場合はランダム生成し、起動ログに1回だけ出力する。
ADMIN_PASSWORD=

# HTTPS のリバースプロキシ経由で利用するときは true にする。
# セッション Cookie に Secure 属性が付与される。
AUTH_COOKIE_SECURE=false

# タイムゾーン。cron 式はこの TZ で解釈する。
TZ=Asia/Tokyo

# 生成ファイルの所有者・権限。
PUID=1000
PGID=1000
UMASK=022

# Web UI の待受ポート。
HTTP_PORT=8080

# DB・yt-dlp venv・ログを置く永続ディレクトリ（コンテナ内パス）。
DATA_DIR=/data
# ダウンロードと後処理の一時領域（コンテナ内パス、常にローカル）。
STAGING_DIR=/data/staging

# local Storage 用の bind mount 先（ホスト側パス）。
MEDIA_ROOT=/mnt/media

# --exec / --exec-before-download の許可。Profile 側の allow_exec との両方が
# 有効な場合のみ許可される（要件定義 §9.3）。UI からは変更できない。
ALLOW_EXEC=false

# 起動時にマイグレーションを自動適用するか。false の場合、未適用の
# リビジョンがあっても起動は継続し、警告のみ出す（`sluicery db upgrade`
# で手動適用する。docs/phase2_指示書.md §5.3）。
AUTO_MIGRATE=true

# Staging 容量監視のしきい値・ログ保持日数・スケジュール（discover/download/
# integrity/yt-dlp 更新の cron 式）・ダウンロードの並列度やレート制限などの
# 運用パラメータは、.env ではなく DB の setting テーブル側で管理する
# （`sluicery settings list` / `set` / `unset`。docs/基本設計.md D-005）。
